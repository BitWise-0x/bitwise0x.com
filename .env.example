# ============================================================
# COMMENTS — Giscus (GitHub Discussions-based comment system)
# Visit https://giscus.app to generate these values.
# Requires: repo must be public, Discussions enabled,
# and the Giscus GitHub App installed on the repo.
# ============================================================
# NEXT_PUBLIC_GISCUS_REPO=
# NEXT_PUBLIC_GISCUS_REPOSITORY_ID=
# NEXT_PUBLIC_GISCUS_CATEGORY=
# NEXT_PUBLIC_GISCUS_CATEGORY_ID=

# ============================================================
# COMMENTS (alternatives — not currently in use)
# Utterances: GitHub Issues-based comments (lighter than Giscus)
# Disqus: third-party hosted comment platform (adds tracking)
# ============================================================
# NEXT_PUBLIC_UTTERANCES_REPO=
# NEXT_PUBLIC_DISQUS_SHORTNAME=

# ============================================================
# ANALYTICS — Umami (privacy-focused, self-hosted analytics)
# https://umami.is — get your website ID from the dashboard
# NEXT_UMAMI_SRC overrides the script URL (defaults to cloud.umami.is)
# NEXT_UMAMI_HOST_URL points beacons at the first-party proxy (workers/proxy)
# so content blockers matching cloud.umami.is do not strip tracking. Leave both
# unset in local dev to fall back to the cloud endpoints.
# e.g. NEXT_UMAMI_SRC=https://bitwise0x.com/i/e.js
#      NEXT_UMAMI_HOST_URL=https://bitwise0x.com/i
# ============================================================
# NEXT_UMAMI_ID=
# NEXT_UMAMI_SRC=
# NEXT_UMAMI_HOST_URL=

# ============================================================
# NEWSLETTER — Buttondown (currently selected provider)
# Minimalist email newsletter service. https://buttondown.email
# ============================================================
# BUTTONDOWN_API_KEY=

# ============================================================
# NEWSLETTER (alternatives — not currently in use)
# Only one provider is used at a time, configured in siteMetadata.js
# ============================================================
# MAILCHIMP_API_KEY=
# MAILCHIMP_API_SERVER=
# MAILCHIMP_AUDIENCE_ID=
#
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=
#
# KLAVIYO_API_KEY=
# KLAVIYO_LIST_ID=
#
# REVUE_API_KEY=                  # Discontinued by Twitter/X
#
# EMAILOCTOPUS_API_KEY=
# EMAILOCTOPUS_LIST_ID=
#
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=
